{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "destination": "https://us-central1-heritage-ai-demo.cloudfunctions.net/api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
